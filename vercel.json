{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm prisma migrate deploy && pnpm build",
  "crons": [
    {
      "path": "/api/jobs/cron/recovery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/cron/email",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/jobs/cron/maintenance",
      "schedule": "17 3 * * *"
    }
  ]
}
