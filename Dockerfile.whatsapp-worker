FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml tsconfig.json ./
COPY vendor ./vendor
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile && pnpm prisma:generate
COPY src ./src
COPY scripts/whatsapp-worker.ts scripts/whatsapp-worker-health.ts scripts/whatsapp-recover-connection.ts ./scripts/
ENV NODE_ENV=production
USER node
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s CMD node --import tsx scripts/whatsapp-worker-health.ts
CMD ["node", "--import", "tsx", "scripts/whatsapp-worker.ts"]
