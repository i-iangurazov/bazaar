{
  "name": "retail-inventory-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "pnpm db:up && pnpm prisma:reset",
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate && pnpm env:check:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts prisma --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm prisma:generate",
    "format": "prettier --write .",
    "test": "vitest",
    "test:db:deterministic": "vitest run --config vitest.config.ts",
    "test:contract:redis": "vitest run --config vitest.redis-contract.config.ts",
    "test:contract:provider": "vitest run --config vitest.provider-contract.config.ts",
    "test:e2e": "playwright test --config=playwright.public.config.ts",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "test:e2e:authenticated:seed": "node --import tsx scripts/playwright-authenticated-fixture.ts",
    "test:e2e:authenticated": "playwright test --config=playwright.authenticated.config.ts",
    "readiness:calculate": "node scripts/production-readiness/calculate-readiness.mjs",
    "readiness:calculate:json": "node scripts/production-readiness/calculate-readiness.mjs --json",
    "readiness:update": "node scripts/production-readiness/update-readiness.mjs",
    "readiness:public-html": "node scripts/production-readiness/check-public-html-budget.mjs",
    "i18n:check": "node --import tsx scripts/i18n-check.ts",
    "test:ci": "pnpm prisma:generate && pnpm typecheck && pnpm lint && pnpm exec vitest run && pnpm i18n:check",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "env:check:build": "node --import tsx scripts/ops-preflight.ts --env-only",
    "ops:preflight": "node --import tsx scripts/ops-preflight.ts",
    "ops:email-check": "node --import tsx scripts/ops-email-flow-check.ts",
    "ops:images-backfill": "node --import tsx scripts/ops-product-images-backfill.ts",
    "profile:hot-paths": "BAZAAR_PROFILE=1 node --import tsx scripts/profile-hot-paths.ts",
    "help:capture": "node --import tsx scripts/help-capture/capture.ts",
    "help:verify": "node --import tsx scripts/help-capture/verify.ts",
    "help:qa": "node --import tsx scripts/help-capture/browser-qa.ts",
    "mobile:validate": "node --import tsx scripts/mobile/validate-config.ts",
    "mobile:assets": "node --import tsx scripts/mobile/generate-assets.ts && capacitor-assets generate --ios --android --assetPath assets",
    "mobile:sync": "pnpm mobile:validate && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:build:android": "pnpm mobile:sync && cd android && ./gradlew assembleDebug bundleRelease",
    "mobile:build:ios": "pnpm mobile:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "mobile:test": "pnpm mobile:validate && vitest run tests/unit/native-*.test.ts tests/unit/mobile-*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^3.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "4.36.1",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^10.45.2",
    "@trpc/next": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "next": "15.5.21",
    "next-auth": "^4.24.15",
    "next-intl": "^4.9.2",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.3.1",
    "qz-tray": "^2.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.51.0",
    "recharts": "^2.12.7",
    "sharp": "^0.35.4",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "@radix-ui/react-dismissable-layer": "1.1.12",
      "@radix-ui/react-focus-scope": "1.1.9",
      "@radix-ui/react-primitive": "2.1.5",
      "@capacitor/assets>@capacitor/cli": "8.5.0",
      "@capacitor/assets>@trapezedev/project": "7.1.10",
      "@capacitor/assets>sharp": "0.35.4",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "eslint-config-next>@typescript-eslint/eslint-plugin": "8.68.0",
      "eslint-config-next>@typescript-eslint/parser": "8.68.0",
      "flatted@3.3.3": "3.4.4",
      "lodash": "4.18.1",
      "minimatch@3.0.5": "3.1.4",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.9",
      "next>postcss": "8.5.26",
      "next>sharp": "0.35.4",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "rollup@4.55.1": "4.63.1",
      "ws@8.20.0": "8.21.0",
      "xcode>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.14.15",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.13.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
