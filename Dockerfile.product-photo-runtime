FROM node:22.23.4-bookworm-slim AS node-dependencies
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate
COPY package.json pnpm-lock.yaml tsconfig.json ./
COPY vendor ./vendor
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile && pnpm prisma:generate

FROM python:3.13.18-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libglib2.0-0 libgomp1 \
    supervisor caddy openssl libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home bazaar \
    && install -d -o bazaar -g bazaar -m 0700 /app/indexes
COPY services/product-photo-search/requirements-compact-linux-x86_64.lock.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r requirements.txt
COPY services/product-photo-search ./services/product-photo-search
COPY models ./models
RUN cd services/product-photo-search && python -m unittest test_readiness test_prepared_index test_stream_rank test_compact_embed test_pipeline test_retrieval test_vision
COPY --from=node-dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=node-dependencies /app/node_modules /app/node_modules
COPY package.json tsconfig.json ./
COPY src ./src
COPY scripts/product-photo-worker.ts scripts/product-photo-runtime-worker.mjs ./scripts/
ENV NODE_ENV=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MALLOC_ARENA_MAX=2 PORT=10000 \
    XDG_CONFIG_HOME=/tmp/caddy-config XDG_DATA_HOME=/tmp/caddy-data \
    PRODUCT_PHOTO_WORKER_ENABLED=0 PRODUCT_PHOTO_WORKER_HEALTH_FILE=/tmp/product-photo-worker.json
USER bazaar
EXPOSE 10000
STOPSIGNAL SIGTERM
CMD ["/usr/bin/supervisord", "-c", "/app/services/product-photo-search/runtime/supervisord.conf"]
