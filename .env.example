NEXT_PUBLIC_PRODUCT_IMAGE_MAX_INPUT_BYTES="33554432"
NEXT_PUBLIC_PRODUCT_IMAGE_DIRECT_UPLOAD_TIMEOUT_MS="120000"
NEXT_PUBLIC_INLINE_EDITING="1"
# Server-only AI. Auto selects DeepSeek when its key is present, otherwise OpenAI.
AI_PROVIDER="auto"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# Optional purpose-specific overrides (vision must use an image-capable model).
DEEPSEEK_BAAM_MODEL=""
DEEPSEEK_VISION_MODEL=""
# Product AI buttons are enabled by default; 0 explicitly disables the UI.
NEXT_PUBLIC_AI_FEATURES_ENABLED="1"
NEXT_PUBLIC_AI_DESCRIPTION_GENERATION_ENABLED="1"
# OpenAI remains the executor for speech recognition and photo retouching.
OPENAI_API_KEY=""
# Dedicated 32-byte random key encoded as canonical base64. Required to upload
# or decrypt private BAAM images; no auth-secret fallback. Retain it for existing
# encrypted media. Private BAAM media is stored in PostgreSQL, including Vercel.
BAAM_MEDIA_ENCRYPTION_KEY=""
OPENAI_MODEL="gpt-5-mini"
PRODUCT_DESCRIPTION_AI_MODEL="gpt-5-mini"
PRODUCT_SPEC_AI_MODEL="gpt-5-mini"
# Studio analyzes the source with the DeepSeek vision configuration above;
# retouching uses the direct image API and no additional OpenAI text model.
# gpt-image-1 was retired on 2026-10-23; use a supported editing model.
PRODUCT_IMAGE_STUDIO_IMAGE_MODEL="gpt-image-2.5-sunburst"
PRODUCT_IMAGE_STUDIO_IMAGE_QUALITY="medium"

