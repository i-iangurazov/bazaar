CRON_SECRET="replace-this-with-an-independent-random-secret"
METRICS_SECRET="replace-this-with-a-strong-secret"
HEALTHCHECK_SECRET="replace-this-with-a-strong-secret"
SIGNUP_MODE="invite_only"
SKIP_EMAIL_VERIFICATION="0"
IMPORT_TRANSACTION_TIMEOUT_MS="120000"
# New public trials last 7 days (src/lib/billing/trial.ts). Existing dates remain unchanged.
# Price overrides apply only to the preserved 2026-10 catalog, not new contracts.
PLAN_PRICE_STARTER_KGS="1750"
PLAN_PRICE_BUSINESS_KGS="4375"
PLAN_PRICE_ENTERPRISE_KGS="8750"
# Subscription checkout is off until merchant onboarding and sandbox acceptance.
# Server-only values; see docs/gopay-billing.md and docs/legal/README.md.
BILLING_PAYMENTS_MODE="disabled"
# New purchases use GoPay only; existing invoices retain their original provider.
BILLING_PAYMENT_PROVIDER=gopay
GOPAY_API_KEY=
GOPAY_API_SECRET=
GOPAY_WEBHOOK_SECRET=
# Keep previous credentials only while old GoPay invoices still need recovery.
GOPAY_PREVIOUS_API_KEY=
GOPAY_PREVIOUS_API_SECRET=
# Historical invoice verification only; these never enable new FreedomPay sales.
FREEDOMPAY_MERCHANT_ID=""
FREEDOMPAY_SECRET_KEY=""
BILLING_PUBLIC_URL=""
BILLING_SELLER_NAME=""
BILLING_TERMS_URL=""
BILLING_TERMS_VERSION=""
BILLING_LIVE_ACTIVATION_CONFIRMED="0"
# Optional exact Organization.id for new Live purchases during the own-business pilot.
# Empty keeps the general rollout. Existing invoice verification is never restricted by this setting.
BILLING_LIVE_PILOT_ORGANIZATION_ID=""
BILLING_SELF_SERVE_SIGNUP="0"
# App Store digital billing is separate from web GoPay and stays off until
# real products, account permissions, terms and sandbox/device acceptance are approved.
# Server-only: never put IAP keys in NEXT_PUBLIC_* or a native app build.
# Configuration/limits/review-org policy: docs/mobile/APPLE_SERVER_BILLING.md.
APPLE_BILLING_MODE="off"
# Explicit reviewed offerKey -> productId/type mapping; empty enables no products.
# Product IDs max100 characters; interchangeable auto subscriptions use one group (max100).
APPLE_BILLING_CATALOG_JSON="[]"
APPLE_APP_ID=""
APPLE_IAP_KEY_ID=""
APPLE_IAP_ISSUER_ID=""
# App Store Connect In-App Purchase API key PEM (escaped newlines supported), not APNs.
APPLE_IAP_PRIVATE_KEY=""
APPLE_BILLING_TERMS_VERSION=""
APPLE_BILLING_TERMS_APPROVED="false"
APPLE_BILLING_SALES_APPROVED="false"
# Optional original-purchaser refund data. off / sandbox / live; separate from
# sales approval. Sandbox also requires the explicit synthetic-org allowlist.
APPLE_CONSUMPTION_REPORTING_MODE="off"
APPLE_BILLING_TEMPORARY_UPGRADES_APPROVED="false"
# Reviewed fixed-band commercial policy only: no default rates/prices/discounts.
APPLE_BILLING_TEMPORARY_UPGRADES_JSON=""
# Exact dedicated synthetic/App Review organization IDs only, comma separated.
# These select Sandbox even in live mode. Never add a real customer organization.
APPLE_BILLING_SANDBOX_ORGANIZATION_IDS=""
# Exact HTTPS test origin; accepted only in VERCEL_ENV=preview + sandbox mode.
# Production native API continues to trust only the canonical www.bazaar.kg origin.
APPLE_BILLING_PREVIEW_ORIGIN=""
