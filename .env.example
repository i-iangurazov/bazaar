# Optional POS commercial channel checkbox (enabled by default).
NEXT_PUBLIC_POS_SALE_CHANNEL_ENABLED=1
# WhatsApp AI: off until partner billing, privacy, inbound cap and a real-number pilot are approved.
# Keep these flags off in preview/test environments. Never copy live provider credentials into tests.
WHATSAPP_AI_ENABLED=0
WHATSAPP_PARTNER_APPROVED=0
WHATSAPP_PRIVACY_APPROVED=0
WHATSAPP_PARTNER_BILLING_CONFIRMED=0
WHATSAPP_INBOUND_SPEND_CAP_CONFIRMED=0
WHATSAPP_PILOT_APPROVED=0
WHATSAPP_PACK_PAYMENTS_APPROVED=0
WHATSAPP_PUBLIC_URL=https://bazaar.kg
# 32 random bytes as 64 hex characters; independent of NEXTAUTH_SECRET.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_PREVIOUS_ENCRYPTION_KEYS=
# Managed Universal Token, not the legacy 24-hour partner login token.
GUPSHUP_UNIVERSAL_TOKEN=
GUPSHUP_UNIVERSAL_TOKEN_EXPIRES_AT=
# Conservative AI spending ceiling, in USD millionths; not a provider wallet cap.
WHATSAPP_DAILY_BUDGET_USD_MICROS=100000000
# 1688 photo-search prototype. Disabled until explicitly configured. Never use NEXT_PUBLIC_ for keys.
# demo uses fixed labelled fixtures without contacting HioBuy; live sends photos externally.
HIOBUY_IMAGE_SEARCH_MODE=disabled
HIOBUY_API_KEY=
# Comma-separated Bazaar organization IDs approved for this pilot (no wildcard).
HIOBUY_IMAGE_SEARCH_ORGANIZATION_IDS=
# Set to 1 only after HioBuy confirms catalog-only search/link-out is permitted for Bazaar.
HIOBUY_CATALOG_USE_CONFIRMED=0
